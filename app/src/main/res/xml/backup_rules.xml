<?xml version="1.0" encoding="utf-8"?>
<!-- FamilyLedger backup rules - API 31+ (fullBackupContent)
     NOTE: allowBackup=false in manifest; these are safety-net exclusions.
     Sensitive financial data must NEVER be backed up. -->
<full-backup-content>
    <!-- Exclude all SharedPreferences (auth tokens, encryption keys, session data) -->
    <exclude domain="sharedpref" path="." />

    <!-- Exclude all databases (financial transactions, ledgers, event logs) -->
    <exclude domain="database" path="." />

    <!-- Exclude internal files (session files, cached credentials) -->
    <exclude domain="root" path="." />

    <!-- Only allow non-sensitive app-specific files if needed -->
    <include domain="file" path="no_backup/" />
</full-backup-content>
